{
  "manifest_version": 3,
  "name": "ChatGPT Local Agent Bridge",
  "version": "0.1.0",
  "description": "把 chatgpt.com 回复中的 agent 指令块转发给本机 Agent 服务执行，并把结果回填到对话。",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chatglm.cn/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.doubao.com/*",
        "https://tongyi.aliyun.com/*",
        "https://www.tongyi.com/*"
      ],
      "js": [
        "adapters/heuristic.js",
        "adapters/chatgpt.js",
        "adapters/chatglm.js",
        "adapters/deepseek.js",
        "adapters/kimi.js",
        "adapters/doubao.js",
        "adapters/qwen.js",
        "adapters/generic.js",
        "adapters/registry.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Agent Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
